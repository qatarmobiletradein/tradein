# =============================================================================
# Qatar Mobile Trade-In — environment template (staging-ready)
#
# Copy to .env for LOCAL development only. Never commit a filled-in copy.
# On Railway, set these as service variables; SEAL every one marked SECRET.
# Every value below is a placeholder. There are no real keys in this file.
# The full checklist (what to set where, per environment) is
# docs/CLOUD_CONFIGURATION.md.
#
# Two groups, never mixed:
#   A. SAFE FOR FRONTEND — may appear in the built frontend (apps/web build).
#   B. SERVER ONLY       — Railway API / jobs / operator tools. Never sent to a
#                          browser, never in apps/web, never logged, never in docs.
# =============================================================================


# -----------------------------------------------------------------------------
# A. SAFE FOR FRONTEND (used only by `npm run web:build`)
# -----------------------------------------------------------------------------
# https origin of the Railway API (http://localhost / 127.0.0.1 allowed for dev only)
QM_API_BASE=http://localhost:8080
# railway | apps-script   (apps-script = legacy transport, comparison only)
QM_TRANSPORT=railway
# Label shown in the UI (DEVELOPMENT / TEST / STAGING / PRODUCTION)
QM_ENVIRONMENT_LABEL=DEVELOPMENT
# password (staff sign in with email + password) | phone (3.1). Must match the API's STAFF_SIGN_IN.
QM_STAFF_SIGN_IN=password
# The frontend needs NO Supabase key: sign-in goes through the Railway API.


# -----------------------------------------------------------------------------
# B. SERVER ONLY — Railway API service
# -----------------------------------------------------------------------------
# development | test | staging | production   (unset = production = strictest)
# staging and production apply the same strict rules (see docs/CLOUD_CONFIGURATION.md).
APP_ENV=development
HOST=0.0.0.0
# Railway sets PORT itself; do not set it there.
PORT=8080
# info in staging/production (debug/trace are refused in production)
LOG_LEVEL=info
# Proxy hops in front of the API whose X-Forwarded-For is trusted (Railway edge = 1; verify in staging)
TRUST_PROXY_HOPS=1

# SECRET. Supabase Postgres connection string for the API (role "postgres").
#   Railway without outbound IPv6: the SESSION pooler (port 5432) —
#     postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres
#   Railway with outbound IPv6 enabled: the direct connection —
#     postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
#   Not the transaction pooler (6543) for migrations; copy the host from the dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Stay below the pooler's pool size (Supabase dashboard → Database settings).
DATABASE_POOL_MAX=10
# require (certificate verified) | no-verify (encrypted, NOT verified — never in production) | disable (development only)
DATABASE_SSL=require
# The database CA certificate (PEM). Supabase: Database settings → SSL configuration → download.
# Paste the PEM (one line with literal \n is fine) or its base64. Not secret, but server-only.
DATABASE_SSL_CA=
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Browser-safe by design, but
# this build uses it only server-side, to call Supabase Auth on the person's behalf.
SUPABASE_PUBLISHABLE_KEY=
# (legacy name, used if the one above is empty)
SUPABASE_ANON_KEY=
# SECRET. Secret key (sb_secret_...) or the legacy service_role key: Storage writes/signing and
# the Supabase Auth admin calls that set up staff sign-in. NEVER in the frontend build.
SUPABASE_SECRET_KEY=
# (legacy name, used if the one above is empty)
SUPABASE_SERVICE_ROLE_KEY=
# Token verification — set the JWKS URL (asymmetric signing keys, recommended) and/or the
# legacy JWT secret (both may be set during a signing-key rotation).
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
#   SECRET. Legacy HS256 JWT secret (>= 32 chars)
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# SECRET. Standard Webhooks secret of the Send SMS Auth Hook ("v1,whsec_...")
SEND_SMS_HOOK_SECRET=

# Comma-separated explicit https origins of the frontend (no "*"; http refused in staging/production).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limits
BODY_LIMIT_BYTES=1048576
UPLOAD_BODY_LIMIT_BYTES=41943040
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
IDEMPOTENCY_TTL_DAYS=7
# Unset = true in staging/production, false in development/test. false is REFUSED in staging/production.
IDEMPOTENCY_KEY_REQUIRED=
SIGNED_URL_TTL_SECONDS=300

# Staff sign-in. Unset = password in staging/production (owner decision), phone in development/test.
# phone is REFUSED in production. Customers always use the SMS code.
STAFF_SIGN_IN=
STAFF_PASSWORD_MIN_LENGTH=12
STAFF_LOGIN_MAX_FAILURES=5
# Reset e-mails per hour for ALL staff; keep below the Supabase project's e-mail limit.
STAFF_RESET_EMAILS_PER_HOUR=25
# true only after "IP address forwarding" is ON in Supabase (Auth > Rate Limits) and the secret key is sb_secret_...
SUPABASE_AUTH_FORWARD_CLIENT_IP=

# SMS: none | twilio | custom | test
#   staging/production: twilio or custom ONLY (none and test are refused)
#   none = fail closed (no codes sent) · test = in-memory, automated tests only
SMS_PROVIDER=none
SMS_MAX_RETRIES=0
SMS_SENDER_ID=
# twilio (SID and FROM are identifiers; the auth token is a SECRET)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# custom https gateway (SECRET key)
CUSTOM_SMS_URL=
CUSTOM_SMS_KEY=

# OTP limits (3.1 defaults; clamped to safe bounds, never disabled).
# OTP_TTL_MINUTES only sets the SMS wording — Supabase Auth's OTP expiry is the real one; keep them equal.
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_S=60
# Wrong codes allowed since the last code was sent (3.1 MAX_ATTEMPTS)
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=6
OTP_MAX_SENDS_PER_DAY=12
OTP_GLOBAL_MAX_PER_HOUR=300
OTP_GLOBAL_MAX_PER_DAY=2000
OTP_REGISTER_GLOBAL_MAX_PER_HOUR=60
OTP_REGISTER_GLOBAL_MAX_PER_DAY=300


# -----------------------------------------------------------------------------
# B. SERVER ONLY — jobs (optional Railway services)
# -----------------------------------------------------------------------------
RECONCILE_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
# B. SERVER ONLY — operator tools (operator machine; never committed)
# -----------------------------------------------------------------------------
# Every write to a non-local database (migrate, seed:staging, import, file migration)
# needs this to equal the Supabase PROJECT REF of the target (printed by the command).
MIGRATION_TARGET_CONFIRM=
# Refs/hosts that must NEVER be touched from this machine. Put the PRODUCTION project ref here.
QM_PROTECTED_TARGETS=

# Staging verification (npm run verify:staging) — all optional
STAGING_API_URL=
# Read-only consistency checks; refused unless the database carries the staging marker
STAGING_DATABASE_URL=
# A token whose exp has passed (e.g. saved from an earlier run) for the expired-token check
QM_EXPIRED_TOKEN=
